---
import '../styles/style.css';
import { SECTIONS, SECTION_LABELS, RUBRIQUES_EN_PROSE } from '../../shared/sections.mjs';

// `largeur` : « lecture » (une colonne de texte, le défaut) ou « large » (toute
// la page, pour une grille de cartes). Les slots « gauche » et « cote » posent
// une colonne latérale de chaque côté du texte, le cours du change, la météo,
// qui passent au-dessus, en bandeaux, sur un écran étroit.
const { title, description, canonical, type = 'website', largeur = 'lecture' } = Astro.props;
// Rendu d'abord, posé ensuite : un brief sans relevé météo remplit le slot
// d'un composant qui ne rend rien, et une colonne vide décalerait le texte.
const cote = Astro.slots.has('cote') ? (await Astro.slots.render('cote')).trim() : '';
const gauche = Astro.slots.has('gauche') ? (await Astro.slots.render('gauche')).trim() : '';
const avecCote = cote.length > 0;
const avecGauche = gauche.length > 0;

// Combien de colonnes la page occupe : c'est ce qui fixe la largeur de
// l'en-tête et du pied, pour que leurs bords tombent sur ceux du contenu.
const colonnes = 1 + Number(avecCote) + Number(avecGauche);

// La barre de navigation, et l'onglet courant. Un préfixe suffit : un brief
// de l'archive allume « Archive », une rubrique allume la sienne. L'accueil
// seul demande l'égalité, sinon il serait allumé partout.
const chemin = Astro.url.pathname;
const onglets = [
  { href: '/', label: "Aujourd'hui", exact: true },
  ...SECTIONS.map((s) => ({ href: `/sections/${s}/`, label: SECTION_LABELS[s] })),
  { href: '/evenements/', label: 'Pop-ups & événements' },
  { href: '/vocabulaire/', label: 'Vocabulaire' },
  { href: '/briefs/', label: 'Archive' },
  { href: '/recherche/', label: 'Rechercher' },
];
const courant = (o) => (o.exact ? chemin === o.href : chemin.startsWith(o.href));
const titreComplet = title ? `${title} · La Matinale de Séoul` : 'La Matinale de Séoul';
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();

const RESUME = `Brief quotidien, ${RUBRIQUES_EN_PROSE}.`;
const résumé = description ?? RESUME;

// Une seule image, statique, pour tout le site. Pas une par brief : cela
// demanderait astro:assets et des polices embarquées dans un projet qui n'a
// aujourd'hui pas une seule image, et le gain ne vaut pas ce coût. Elle porte
// la mention de production automatique, comme tout ce qui sort d'ici.
const image = new URL('/og.png', Astro.site).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* La barre du navigateur mobile prend la couleur du fond, dans les deux
        thèmes : le site ne commence pas par une bande blanche sur une page
        sombre. Les deux valeurs sont celles de --fond dans style.css. */}
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16151a" media="(prefers-color-scheme: dark)" />
    <title>{titreComplet}</title>
    <meta name="description" content={résumé} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="La Matinale de Séoul" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="La Matinale de Séoul · Pop-ups &amp; événements" href="/evenements.xml" />

    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={résumé} />
    <meta property="og:site_name" content="La Matinale de Séoul" />
    <meta property="og:locale" content="fr_FR" />
    {/* « article » sur la page d'un brief, « website » ailleurs : un brief est
        daté et se cite, l'accueil ne l'est pas. */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="tete" />
  </head>

  <body data-colonnes={colonnes} data-largeur={largeur}>
    <a class="saut" href="#contenu">Aller au contenu</a>

    <header class="entete">
      <p class="marque"><a href="/">La Matinale de Séoul</a></p>
      {/* Le bouton du menu, pour un téléphone. Le script ci-dessous le montre
          et replie les onglets ; sans script, les onglets restent en bande
          qui défile, et le bouton n'existe pas. */}
      <button class="burger" type="button" aria-expanded="false" aria-controls="navigation" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
      <nav id="navigation" aria-label="Navigation principale">
        {onglets.map((o) => (
          <a href={o.href} aria-current={courant(o) ? 'page' : undefined}>{o.label}</a>
        ))}
      </nav>
    </header>

    <script>
      // Le menu d'un téléphone : ouvert ou fermé, c'est l'en-tête qui le dit
      // (data-menu), et c'est la feuille de style qui décide ce que ça montre,
      // rien du tout sur un grand écran, où les onglets sont toujours là.
      const entete = document.querySelector<HTMLElement>('.entete');
      const bouton = entete?.querySelector<HTMLButtonElement>('.burger');
      if (entete && bouton) {
        const ouvrir = (ouvert: boolean) => {
          entete.dataset.menu = ouvert ? 'ouvert' : 'ferme';
          bouton.setAttribute('aria-expanded', String(ouvert));
        };
        ouvrir(false);
        bouton.addEventListener('click', () => ouvrir(entete.dataset.menu !== 'ouvert'));
        // Échap referme et rend le focus au bouton ; un clic ailleurs referme.
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && entete.dataset.menu === 'ouvert') {
            ouvrir(false);
            bouton.focus();
          }
        });
        document.addEventListener('click', (e) => {
          if (entete.dataset.menu === 'ouvert' && !entete.contains(e.target as Node)) ouvrir(false);
        });
      }

      // La hauteur de l'en-tête, publiée en --hauteur-entete. La barre étant
      // collante, deux choses en dépendent : les colonnes latérales, qui
      // collent sous elle, et les ancres, qui ne doivent pas atterrir derrière.
      // Elle n'est pas constante — dix onglets tiennent sur une ligne à côté de
      // la marque sur une page à trois colonnes, sur deux lignes en dessous sur
      // une page de lecture — donc on la mesure au lieu de l'écrire. style.css
      // porte un repli pour le lecteur sans script, qui n'a d'ailleurs pas de
      // barre collante non plus.
      //
      // Pas pendant que le menu du téléphone est déplié : la liste ouverte
      // ferait bondir la valeur, et c'est elle qui plafonne sa propre hauteur.
      if (entete && 'ResizeObserver' in window) {
        const mesurer = () => {
          if (entete.dataset.menu === 'ouvert') return;
          document.documentElement.style.setProperty('--hauteur-entete', `${entete.offsetHeight}px`);
        };
        new ResizeObserver(mesurer).observe(entete);
        mesurer();
      }
    </script>

    <div
      class="page"
      data-largeur={largeur}
      data-cote={avecCote ? 'oui' : 'non'}
      data-gauche={avecGauche ? 'oui' : 'non'}
    >
      <main id="contenu">
        <slot />
      </main>
      {/* Après le texte dans le document, à sa gauche à l'écran : le lecteur
          d'écran et le clavier arrivent au brief d'abord. */}
      {avecGauche && <aside class="gauche" set:html={gauche} />}
      {avecCote && <aside class="cote" set:html={cote} />}
    </div>

    <footer class="pied">
      <p>
        {/* Sur une ligne : le compilateur avale l'espace au retour à la ligne
            entre le texte et le lien, et « sept.Flux RSS » sortait collé. */}
        <strong>La Matinale de Séoul</strong>, brief quotidien, sept jours sur sept. <a href="/rss.xml">Flux RSS</a> · <a href="/evenements.xml">Flux des événements</a>
      </p>
      <p class="mention">
        Contenu produit automatiquement. Les résumés sont rédigés par une IA à partir
        des articles cités : ils peuvent se tromper, et rien n'est relu par un humain
        avant publication. Chaque item porte le lien de sa source, la vérification
        vous revient.
      </p>
    </footer>
  </body>
</html>
