---
// La tête d'une page de liste, rubrique, étiquette, sur le modèle de celle
// d'un brief : un surtitre en petites capitales, le titre, le chapeau.
//
// Le lecteur qui arrive de l'accueil doit retrouver la même mise en page. Un
// h1 nu suivi d'une phrase n'était pas une autre page du même site, c'était
// une autre page.
//
// `langTitre` : la langue du titre quand ce n'est pas celle de la page, le
// nom coréen d'un lieu. Les lecteurs d'écran et la typographie le traitent
// alors comme tel.
const { surtitre, titre, langTitre } = Astro.props;
---

<header class="tete">
  {surtitre && <p class="surtitre">{surtitre}</p>}
  <h1 lang={langTitre}>{titre}</h1>
  {Astro.slots.has('default') && <p class="chapeau"><slot /></p>}
</header>
