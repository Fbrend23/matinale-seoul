---
// Un événement, en carte.
//
// Une carte et non un item de brief : on parcourt l'onglet des yeux pour
// trouver ce qui se passe ce week-end, pas pour lire de haut en bas. D'où le
// thème en couleur, les dates et le lieu avant le texte, et les liens en pied.
import { dateRange } from '../lib/date.js';
import { KIND_LABELS, THEME_LABELS, lienNaverMap, badgeDélai } from '../../shared/evenements.mjs';

const { event, today } = Astro.props;

// Combien de jours il reste — le nombre, pas un « bientôt » : c'est lui qui
// décide d'un week-end. Calculé au build, comme le reste de la page, qui se
// reconstruit chaque matin.
const badge = today ? badgeDélai(event, today) : null;

// La fiche vue par l'agent quand il y en a une, le lien de recherche sinon.
// Le second n'est jamais inventé : il pose une question à Naver, il n'affirme
// pas une adresse.
const carte = event.map_url ?? lienNaverMap(event);
---

{/* Les deux dates sont posées en data-* pour le script de la page, qui
    masque chez le lecteur ce qui a fini depuis le build. */}
<article class="evenement" id={`evenement-${event.id}`} data-debut={event.start_date} data-fin={event.end_date} data-theme={event.theme}>
  <p class="evenement-theme">
    <span class="pastille">{THEME_LABELS[event.theme] ?? event.theme}</span>
    <span class="genre">{KIND_LABELS[event.kind] ?? event.kind}</span>
    {badge && <span class="delai" data-urgent={badge.urgent ? 'oui' : 'non'}>{badge.texte}</span>}
  </p>

  <h3>{event.name}</h3>

  <p class="evenement-quand">
    <time datetime={event.start_date}>{dateRange(event.start_date, event.end_date)}</time>
  </p>
  {/* Le lieu est en coréen, tel que Naver Map l'écrit : lang="ko" pour que
      les lecteurs d'écran et la typographie le traitent comme tel. */}
  <p class="evenement-ou"><span lang="ko">{event.venue}</span> · {event.area}</p>

  <p class="resume">{event.summary}</p>

  <p class="evenement-liens">
    {/* rel="nofollow ugc" : ces liens sont choisis par une machine — la fiche
        Naver Map et la billetterie comme la source. */}
    <a
      class="bouton"
      href={carte}
      rel="nofollow ugc noopener"
      target="_blank"
      aria-label="Voir sur Naver Map — s'ouvre dans une nouvelle fenêtre"
    >
      Naver Map
    </a>
    {event.booking_url && (
      <a
        class="bouton"
        href={event.booking_url}
        rel="nofollow ugc noopener"
        target="_blank"
        aria-label="Réserver — s'ouvre dans une nouvelle fenêtre"
      >
        Réserver
      </a>
    )}
    <a
      class="source-lien"
      href={event.source_url}
      rel="nofollow ugc noopener"
      target="_blank"
      aria-label={`Source : ${event.source_name} — s'ouvre dans une nouvelle fenêtre`}
    >
      {event.source_name}
    </a>
  </p>
</article>
