---
import NewsItem from './NewsItem.astro';
import AiNotice from './AiNotice.astro';
import { SECTION_LABELS } from '../../shared/sections.mjs';
import { longDate } from '../lib/date.js';

// `indexable` : la page d'archive du brief le pose, l'accueil non. Le même
// brief y est rendu deux fois, et la recherche ne doit le trouver qu'une
// fois, à son adresse durable. Dès qu'une page porte data-pagefind-body,
// Pagefind ignore toutes celles qui ne le portent pas : rubriques,
// étiquettes et événements sortent de l'index d'eux-mêmes.
const { brief, headingLevel = 'h1', indexable = false } = Astro.props;
const Titre = headingLevel;
---

<article class="brief" data-pagefind-body={indexable ? '' : undefined}>
  <header>
    {/* La date est mise en avant : le lecteur doit savoir de quel jour il lit le
        brief, y compris quand celui du jour n'est pas encore paru. La
        recherche la reprend en métadonnée, et trie dessus par l'attribut. */}
    <p class="date"><time datetime={brief.date} data-pagefind-meta="date" data-pagefind-sort="date[datetime]">{longDate(brief.date)}</time></p>
    <Titre>{brief.title}</Titre>
    <p class="chapeau">{brief.standfirst}</p>
  </header>

  {brief.sections.map((section) => (
    <section class="rubrique-bloc" aria-labelledby={`s-${brief.id}-${section.key}`}>
      <h2 id={`s-${brief.id}-${section.key}`}>{SECTION_LABELS[section.key]}</h2>

      {/* La phrase écrite ce matin-là, et non une formule générale : l'agent
          dit pourquoi il n'a rien retenu, et l'ingestion dit quand ce sont les
          gardes qui ont vidé la rubrique. Le repli sert les briefs parus avant
          que ce texte ne soit conservé. */}
      {section.items.length === 0 ? (
        <p class="vide">
          {section.empty_note ?? "Rien à signaler dans cette rubrique aujourd'hui."}
        </p>
      ) : (
        section.items.map((item) => <NewsItem item={item} />)
      )}
    </section>
  ))}

  <AiNotice />
</article>
