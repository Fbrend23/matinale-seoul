---
import { sourceTime } from '../lib/date.js';
import { tagPages } from '../lib/content.js';

const { item, showSection = false, sectionLabel = null } = Astro.props;
const quand = sourceTime(item.published_at);
const tags = Array.isArray(item.tags) ? item.tags : [];

// Toutes les étiquettes n'ont pas de page : celles qui ne portent qu'un item
// n'en méritent pas, et celles d'un brief plus vieux que la fenêtre n'en ont
// plus. On demande donc la liste plutôt que de la supposer — lier sans vérifier
// sèmerait un 404 par étiquette, sur un site statique où rien ne le dirait.
// L'appel est mémoïsé : il ne coûte qu'une fois pour tout le build.
const avecPage = await tagPages();
---

<article class="item">
  <h3>{item.headline}</h3>

  {showSection && sectionLabel && <p class="rubrique">{sectionLabel}</p>}

  <p class="resume">{item.summary}</p>

  {item.analysis && (
    <p class="analyse"><span>Ce qu'il faut y voir</span> {item.analysis}</p>
  )}

  <p class="source">
    {/* rel="nofollow ugc" : ces liens sont choisis par une machine, on ne
        transmet pas de recommandation avec eux. */}
    {/* Le libellé dit l'ouverture en nouvelle fenêtre : à la lecture d'écran,
        un lien qui change de contexte sans le dire fait perdre sa place. */}
    <a
      href={item.source_url}
      rel="nofollow ugc noopener"
      target="_blank"
      aria-label={`${item.source_name} — s'ouvre dans une nouvelle fenêtre`}
    >
      {item.source_name}
    </a>
    {item.source_lang && <span class="langue"> · {item.source_lang}</span>}
    {quand && <span class="quand"> · {quand}</span>}
  </p>

  {/* Cliquables quand il y a quelque chose à aller voir : le schéma les
      contraint, l'agent les pose, le CMS les garde. Celles qui n'ont pas de
      page restent affichées — l'information ne se perd pas, seul le lien
      manque. */}
  {tags.length > 0 && (
    <ul class="etiquettes">
      {tags.map((tag) =>
        avecPage.has(tag) ? (
          <li><a href={`/tags/${tag}/`}>{tag}</a></li>
        ) : (
          <li><span>{tag}</span></li>
        )
      )}
    </ul>
  )}
</article>
