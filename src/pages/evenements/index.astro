---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TetePage from '../../components/TetePage.astro';
import Evenement from '../../components/Evenement.astro';
import AiNotice from '../../components/AiNotice.astro';
import { listEvents } from '../../lib/content.js';
import { seoulToday } from '../../lib/date.js';
import { grouperParÉtat, trierEvents, TRIS, TRI_LABELS, TRI_PAR_DEFAUT, THEMES, THEME_LABELS, THEMES_EN_PROSE } from '../../../shared/evenements.mjs';
import { NAVER_MAPS_CLIENT_ID } from 'astro:env/client';

// TOUT ce qui est en cours ou à venir, quel que soit le brief qui l'a repéré.
// L'agent du matin ne fait qu'ajouter ; c'est la collection qui tient la liste,
// et la date de fin qui en fait sortir chaque événement.
//
// Le flux de cette page est /evenements.xml : un élément par événement, à
// l'inverse du flux des briefs, on le suit pour être prévenu de chacun.
const events = await listEvents();
const aujourdhui = seoulToday();

// Ce qui finit le plus tôt d'abord : c'est ce qu'on risque de rater. Le
// lecteur peut en changer, le script retrie les cartes sans rien recharger.
const { enCours, àVenir } = grouperParÉtat(trierEvents(events, TRI_PAR_DEFAUT), aujourdhui);

// La carte ne pose que ce qu'elle sait placer : les événements dont l'agent a
// vu l'adresse. Le compte du build est celui-là ; le script le remplace par
// les pins que Naver a bien posés, une fois la carte ouverte.
const placés = events.filter((e) => e.address).length;

// Ce qui est ouvert d'abord : c'est la question qu'on se pose. Les deux
// groupes ne se recouvrent pas, une grille qui répète ses cartes ne se
// parcourt plus.
const groupes = [
  {
    id: 'en-ce-moment',
    titre: 'En ce moment',
    détail: 'ouvert aujourd’hui',
    events: enCours,
    vide: 'Rien d’ouvert en ce moment.',
  },
  {
    id: 'a-venir',
    titre: 'Plus tard',
    détail: 'pas encore commencé',
    events: àVenir,
    vide: 'Rien d’annoncé pour l’instant.',
  },
];
---

<BaseLayout
  largeur="large"
  title="Pop-ups & événements"
  description={`Pop-ups, concerts, expositions et salons à Séoul, ${THEMES_EN_PROSE}. ${events.length} en cours ou à venir.`}
>
  <TetePage surtitre="À Séoul" titre="Pop-ups & événements">
    Pop-ups, concerts, expositions et salons à Séoul, {THEMES_EN_PROSE}.
    Seuls les événements en cours ou annoncés sont listés ; ils sortent de la
    page à leur date de fin.
    <a href="/evenements.xml">S’abonner au flux</a> pour être prévenu de chaque nouveau.
  </TetePage>

  {/* Masqués sans JavaScript : un bouton qui ne filtre rien et un menu qui ne
      trie rien sont des mensonges. Le script les révèle. */}
  <div class="filtres" role="group" aria-label="Filtrer par thème" hidden>
    <button type="button" data-filtre="tous" aria-pressed="true">Tous</button>
    {THEMES.map((theme) => (
      <button type="button" data-filtre={theme} aria-pressed="false">{THEME_LABELS[theme]}</button>
    ))}
  </div>
  <p class="tri" hidden>
    <label for="tri">Trier</label>
    <select id="tri">
      {TRIS.map((tri) => (
        <option value={tri} selected={tri === TRI_PAR_DEFAUT}>{TRI_LABELS[tri]}</option>
      ))}
    </select>
  </p>

  {/* La carte Naver, seulement si le build a un client ID : sans lui, pas de
      bloc du tout. Masquée sans JavaScript, c'est lui qui la dessine, et
      repliée sur un téléphone, comme « Plus tard ». Le navigateur du lecteur
      géocode les adresses à l'ouverture : rien de Naver n'est stocké, ses
      conditions l'interdisent, voir src/lib/carte-naver.js. */}
  {NAVER_MAPS_CLIENT_ID && (
    <details class="carte-evenements" id="sur-la-carte" data-cle={NAVER_MAPS_CLIENT_ID} open hidden>
      <summary>
        <h2>Sur la carte <span class="detail">les lieux dont l’adresse est connue</span> <span class="compte">{placés}</span></h2>
      </summary>
      <div class="carte-naver" role="region" aria-label="Carte Naver des événements"></div>
      <p class="carte-note">Un pin par événement dont l’adresse est connue, posé par Naver Map à l’ouverture de la carte.</p>
    </details>
  )}

  {/* Chaque groupe se replie : sur un téléphone, le script ferme « Plus
      tard », et le compte dans le titre dit ce qu'on y trouve.
      Ouverts au build, sans script, tout se lit. */}
  {groupes.map(({ id, titre, détail, events, vide }) => (
    <details class="groupe-evenements" id={id} open>
      <summary>
        <h2>{titre} <span class="detail">{détail}</span> <span class="compte">{events.length}</span></h2>
      </summary>
      {/* Le message de vide est toujours rendu, masqué quand il y a de quoi
          lire : le filtre et le masquage des terminés peuvent vider un groupe. */}
      <p class="vide" hidden={events.length > 0}>{vide}</p>
      <div class="cartes">
        {events.map((event) => <Evenement event={event} today={aujourdhui} />)}
      </div>
    </details>
  ))}

  <script>
    // Deux choses que le build ne peut pas décider : le jour où le lecteur
    // regarde, le site se reconstruit chaque matin, mais un build peut
    // échouer, et un pop-up terminé ne doit pas rester affiché, et le thème
    // qu'il veut voir.
    import { seoulToday } from '../../lib/date.js';
    import { comparateur, TRIS, TRI_PAR_DEFAUT } from '../../../shared/evenements.mjs';
    import { préparerLaCarte } from '../../lib/carte-naver.js';

    const aujourdhui = seoulToday();
    const cartes = [...document.querySelectorAll<HTMLElement>('.evenement')];
    const surTéléphone = matchMedia('(max-width: 48rem)').matches;

    // Terminé depuis le build : masqué pour de bon, quel que soit le filtre.
    for (const carte of cartes) {
      if (carte.dataset.fin && carte.dataset.fin < aujourdhui) carte.dataset.termine = 'oui';
    }

    let filtre = 'tous';
    let tri = TRI_PAR_DEFAUT;
    try {
      // Le dernier filtre et le dernier tri choisis, pour ce navigateur
      // seulement : un confort, pas un état. Sans stockage, on repart de
      // « tous » et du tri du build.
      filtre = localStorage.getItem('evenements:filtre') ?? 'tous';
      tri = localStorage.getItem('evenements:tri') ?? TRI_PAR_DEFAUT;
    } catch {}

    const boutons = [...document.querySelectorAll<HTMLButtonElement>('.filtres button')];
    if (!boutons.some((b) => b.dataset.filtre === filtre)) filtre = 'tous';
    if (!TRIS.includes(tri)) tri = TRI_PAR_DEFAUT;

    // Le tri lit la carte comme le build lit l'événement : mêmes champs, même
    // comparateur, pour que changer de tri puis y revenir rende l'ordre du build.
    const commeEvent = (carte: HTMLElement) => ({
      name: carte.querySelector('h3')?.textContent ?? '',
      start_date: carte.dataset.debut ?? '',
      end_date: carte.dataset.fin ?? '',
      date_created: carte.dataset.repere ?? '',
    });

    function retrier() {
      const parCarte = comparateur(tri);
      for (const grille of document.querySelectorAll<HTMLElement>('.cartes')) {
        const siennes = [...grille.querySelectorAll<HTMLElement>('.evenement')];
        siennes.sort((a, b) => parCarte(commeEvent(a), commeEvent(b)));
        // append() déplace un nœud déjà dans l'arbre : pas de copie, les
        // écouteurs et l'état des cartes restent.
        grille.append(...siennes);
      }
    }

    function appliquer() {
      for (const carte of cartes) {
        const hors = filtre !== 'tous' && carte.dataset.theme !== filtre;
        carte.hidden = hors || carte.dataset.termine === 'oui';
      }
      for (const bouton of boutons) {
        bouton.setAttribute('aria-pressed', String(bouton.dataset.filtre === filtre));
      }
      for (const bloc of document.querySelectorAll('.groupe-evenements')) {
        const visibles = [...bloc.querySelectorAll<HTMLElement>('.evenement')].filter((c) => !c.hidden).length;
        const vide = bloc.querySelector<HTMLElement>('.vide');
        if (vide) vide.hidden = visibles > 0;
        const compte = bloc.querySelector<HTMLElement>('.compte');
        if (compte) compte.textContent = String(visibles);
      }
      // Les pins suivent les cartes : masquée, plus de pin.
      carteNaver.synchroniser();
    }

    for (const bouton of boutons) {
      bouton.addEventListener('click', () => {
        filtre = bouton.dataset.filtre ?? 'tous';
        try {
          localStorage.setItem('evenements:filtre', filtre);
        } catch {}
        appliquer();
      });
    }

    const menuTri = document.querySelector<HTMLSelectElement>('#tri');
    if (menuTri) {
      menuTri.value = tri;
      menuTri.addEventListener('change', () => {
        tri = TRIS.includes(menuTri.value) ? menuTri.value : TRI_PAR_DEFAUT;
        try {
          localStorage.setItem('evenements:tri', tri);
        } catch {}
        retrier();
      });
      const blocTri = menuTri.closest<HTMLElement>('.tri');
      if (blocTri) blocTri.hidden = false;
    }

    // La carte, si le build en a une : préparée avant appliquer(), qui la
    // tient d'accord avec le filtre dès le premier passage.
    const blocCarte = document.querySelector<HTMLDetailsElement>('#sur-la-carte');
    const carteNaver = blocCarte
      ? préparerLaCarte({ bloc: blocCarte, cartes, surTéléphone })
      : { synchroniser() {} };

    // Le build a déjà trié selon le tri par défaut : on ne retrie que si le
    // lecteur en avait choisi un autre.
    if (tri !== TRI_PAR_DEFAUT) retrier();
    appliquer();
    const filtres = document.querySelector<HTMLElement>('.filtres');
    if (filtres) {
      filtres.hidden = false;
      // Sur un téléphone, les filtres défilent en bande : le filtre retenu
      // doit être sous les yeux, pas hors champ à droite.
      const retenu = boutons.find((b) => b.dataset.filtre === filtre);
      if (retenu && retenu.offsetLeft + retenu.offsetWidth > filtres.clientWidth) {
        filtres.scrollLeft = retenu.offsetLeft - 16;
      }
    }

    // Sur un téléphone, seul « En ce moment » est déplié : « Plus tard »
    // allonge la page, et son titre dit combien d'événements il tient. Au
    // chargement seulement, ce que le lecteur ouvre ensuite reste ouvert.
    if (surTéléphone) {
      for (const bloc of document.querySelectorAll<HTMLDetailsElement>('.groupe-evenements:not(#en-ce-moment)')) {
        bloc.open = false;
      }
    }
  </script>

  <AiNotice />
</BaseLayout>
