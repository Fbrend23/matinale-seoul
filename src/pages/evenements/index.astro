---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Evenement from '../../components/Evenement.astro';
import AiNotice from '../../components/AiNotice.astro';
import { listEvents } from '../../lib/content.js';
import { seoulToday } from '../../lib/date.js';
import { grouperParÉtat, THEMES_EN_PROSE } from '../../../shared/evenements.mjs';

// TOUT ce qui est en cours ou à venir, quel que soit le brief qui l'a repéré.
// L'agent du matin ne fait qu'ajouter ; c'est la collection qui tient la liste,
// et la date de fin qui en fait sortir chaque événement.
//
// Pas de flux RSS pour cette page, à dessein : le flux est « un élément par
// brief », et un événement n'est pas une parution.
const events = await listEvents();
const aujourdhui = seoulToday();
const { enCours, àVenir } = grouperParÉtat(events, aujourdhui);

const groupes = [
  { id: 'en-cours', titre: 'En ce moment', events: enCours, vide: 'Rien en ce moment.' },
  { id: 'a-venir', titre: 'À venir', events: àVenir, vide: "Rien d'annoncé pour l'instant." },
];
---

<BaseLayout
  title="Pop-ups & événements"
  description={`Pop-ups, concerts, expositions et salons à Séoul — ${THEMES_EN_PROSE}. ${events.length} en cours ou à venir.`}
>
  <h1>Pop-ups &amp; événements</h1>
  <p class="chapeau">
    Pop-ups, concerts, expositions et salons à Séoul — {THEMES_EN_PROSE}.
    Seuls les événements en cours ou annoncés sont listés ; ils sortent de la
    page à leur date de fin.
  </p>

  {groupes.map(({ id, titre, events, vide }) => (
    <section class="jour-bloc" id={id}>
      <h2>{titre}</h2>
      {/* Le message de vide est toujours rendu, masqué quand il y a de quoi
          lire : le script ci-dessous peut vider un groupe après le build. */}
      <p class="vide" hidden={events.length > 0}>{vide}</p>
      {events.map((event) => <Evenement event={event} />)}
    </section>
  ))}

  <script>
    // Le même principe que l'avis de parution de l'accueil : « aujourd'hui »
    // ne peut pas être figé au build. Le site se reconstruit chaque matin, donc
    // presque rien ne change ici — sauf le jour où le build échoue, et c'est
    // ce jour-là qu'un pop-up terminé ne doit pas rester affiché.
    import { seoulToday } from '../../lib/date.js';

    const aujourdhui = seoulToday();
    const enCours = document.getElementById('en-cours');

    for (const carte of document.querySelectorAll<HTMLElement>('.evenement')) {
      const { debut, fin } = carte.dataset;
      // Comparaison de deux AAAA-MM-JJ : l'ordre des chaînes est celui des jours.
      if (fin && fin < aujourdhui) {
        carte.hidden = true;
      } else if (debut && debut <= aujourdhui && enCours && !enCours.contains(carte)) {
        // Commencé depuis le build : il change de groupe.
        enCours.append(carte);
      }
    }

    for (const bloc of document.querySelectorAll('.jour-bloc')) {
      const vide = bloc.querySelector<HTMLElement>('.vide');
      if (!vide) continue;
      vide.hidden = [...bloc.querySelectorAll<HTMLElement>('.evenement')].some((c) => !c.hidden);
    }
  </script>

  <AiNotice />
</BaseLayout>
