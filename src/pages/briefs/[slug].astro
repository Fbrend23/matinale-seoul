---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BriefArticle from '../../components/BriefArticle.astro';
import BulletinMeteo from '../../components/BulletinMeteo.astro';
import { allBriefs } from '../../lib/content.js';
import { longDate } from '../../lib/date.js';

export async function getStaticPaths() {
  const briefs = await allBriefs();

  return briefs.map((brief, index) => ({
    params: { slug: brief.slug },
    props: {
      brief,
      // Voisins chronologiques : l'archive se lit de proche en proche, pas
      // seulement par la liste.
      plusRecent: index > 0 ? briefs[index - 1] : null,
      plusAncien: index < briefs.length - 1 ? briefs[index + 1] : null,
    },
  }));
}

const { brief, plusRecent, plusAncien } = Astro.props;

// Ce qu'un agrégateur lit quand il range ce brief.
//
// « isAccessibleForFree » et l'éditeur nommé ne sont pas décoratifs : le brief
// est produit sans relecture humaine, et cette page le dit au lecteur par
// AiNotice. Le dire aussi aux machines relève de la même honnêteté — la mention
// est portée par le brief, jamais seulement par le pied de page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: brief.title,
  description: brief.standfirst,
  datePublished: `${brief.date}T08:00:00+09:00`,
  dateModified: brief.ingested_at ?? `${brief.date}T08:00:00+09:00`,
  inLanguage: 'fr',
  isAccessibleForFree: true,
  mainEntityOfPage: new URL(`/briefs/${brief.slug}/`, Astro.site).toString(),
  publisher: { '@type': 'Organization', name: 'La Matinale de Séoul' },
  creator: { '@type': 'Organization', name: 'La Matinale de Séoul (production automatisée)' },
};
---

<BaseLayout title={brief.title} description={brief.standfirst} type="article">
  <script
    slot="tete"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <BulletinMeteo slot="cote" weather={brief.weather} date={brief.date} />

  <BriefArticle brief={brief} />

  <nav class="voisins" aria-label="Autres briefs">
    {plusAncien && (
      <a href={`/briefs/${plusAncien.slug}/`}>← {longDate(plusAncien.date)}</a>
    )}
    {plusRecent && (
      <a href={`/briefs/${plusRecent.slug}/`}>{longDate(plusRecent.date)} →</a>
    )}
  </nav>
</BaseLayout>
