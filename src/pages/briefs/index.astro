---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TetePage from '../../components/TetePage.astro';
import { listBriefs } from '../../lib/content.js';
import { longDate } from '../../lib/date.js';
import { grouperParMois, moisLisible, moisCourt, MIN_MOIS_POUR_NAV } from '../../lib/archive.js';

const briefs = await listBriefs();

// Groupés par mois : une liste plate de plusieurs centaines de jours ne se
// parcourt pas. Le regroupement vit dans src/lib/archive.js, où il se teste.
const mois = grouperParMois(briefs);

// La barre qui saute d'un mois à l'autre, dès qu'il y en a deux. Des ancres,
// pas un script : la page reste lisible sans lui, et le navigateur sait déjà
// défiler jusqu'à un id.
const avecNav = mois.length >= MIN_MOIS_POUR_NAV;

// listBriefs() lève plutôt que de rendre une liste vide : ces deux bornes
// existent donc toujours. Les nommer ici évite de le redemander deux fois plus
// bas, et dit au passage pourquoi c'est sûr.
const plusRecent = briefs[0];
const plusAncien = briefs[briefs.length - 1];
---

<BaseLayout
  title="Archive"
  description={`${briefs.length} briefs publiés depuis le ${plusAncien.date}.`}
>
  <TetePage surtitre="Tous les briefs" titre="Archive">
    {briefs.length} brief{briefs.length > 1 ? 's' : ''} publié{briefs.length > 1 ? 's' : ''},
    du {longDate(plusAncien.date)} au {longDate(plusRecent.date)}.
  </TetePage>

  {avecNav && (
    <nav class="mois-nav" aria-label="Aller à un mois">
      {mois.map(({ clé, id }) => (
        <a href={`#${id}`}>{moisCourt(clé)}</a>
      ))}
    </nav>
  )}

  {mois.map(({ clé, id, briefs: dumois }) => (
    <section class="mois" id={id}>
      <h2>{moisLisible(clé)}</h2>
      <ul>
        {dumois.map((brief) => (
          <li>
            <a href={`/briefs/${brief.slug}/`}>
              <span class="jour"><time datetime={brief.date}>{brief.date.slice(8)}</time></span>
              <span class="titre">{brief.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
