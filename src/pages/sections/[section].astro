---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsItem from '../../components/NewsItem.astro';
import AiNotice from '../../components/AiNotice.astro';
import TetePage from '../../components/TetePage.astro';
import AutresRubriques from '../../components/AutresRubriques.astro';
import BulletinMeteo from '../../components/BulletinMeteo.astro';
import CoursDuChange from '../../components/CoursDuChange.astro';
import { recentBriefs, dernierBrief } from '../../lib/content.js';
import { SECTIONS, SECTION_LABELS } from '../../../shared/sections.mjs';
import { longDate } from '../../lib/date.js';

export async function getStaticPaths() {
  // Trente jours : au-delà, une rubrique se lit par l'archive, brief par brief.
  const briefs = await recentBriefs(30);

  return SECTIONS.map((section) => ({
    params: { section },
    props: {
      section,
      jours: briefs
        .map((brief) => ({
          brief,
          items: brief.sections.find((s) => s.key === section)?.items ?? [],
        }))
        .filter((jour) => jour.items.length > 0),
    },
  }));
}

const { section, jours } = Astro.props;
const total = jours.reduce((n, jour) => n + jour.items.length, 0);

// Le contexte du jour, comme sur l'accueil : la page garde le même cadre d'un
// onglet à l'autre, et le lecteur lit une rubrique aujourd'hui, pas hors du
// temps.
const dernier = await dernierBrief();

// Le chapeau dit ce qu'on va lire, et jusqu'où ça remonte — la fenêtre est
// de trente jours, mais le premier jour qui a quelque chose peut être plus
// proche.
const plusAncien = jours[jours.length - 1]?.brief;
---

<BaseLayout
  title={SECTION_LABELS[section]}
  description={`${SECTION_LABELS[section]} : ${total} items sur les trente derniers briefs.`}
>
  <BulletinMeteo slot="cote" weather={dernier.weather} date={dernier.date} />
  <CoursDuChange slot="gauche" fx={dernier.fx} />

  <TetePage surtitre="Rubrique" titre={SECTION_LABELS[section]}>
    {total === 0
      ? 'Rien reçu ces trente derniers jours.'
      : `${total} item${total > 1 ? 's' : ''} sur ${jours.length} jour${jours.length > 1 ? 's' : ''}, depuis le ${longDate(plusAncien.date)}. Le plus récent d'abord.`}
  </TetePage>

  {jours.length === 0 ? (
    <p class="vide">
      Cette rubrique n'a rien reçu ces trente derniers jours. Ce n'est pas une panne :
      certaines journées sont creuses, et le brief le dit plutôt que de meubler.
    </p>
  ) : (
    jours.map(({ brief, items }) => (
      <section class="jour-bloc" aria-labelledby={`j-${brief.id}`}>
        {/* La date en titre, comme la rubrique l'est sur l'accueil ; le lien
            vers le brief complet à part, en clair, plutôt qu'un titre entier
            souligné. */}
        <h2>
          <time id={`j-${brief.id}`} datetime={brief.date}>{longDate(brief.date)}</time>
          <a class="detail" href={`/briefs/${brief.slug}/`}>Lire le brief du jour →</a>
        </h2>
        {items.map((item) => <NewsItem item={item} />)}
      </section>
    ))
  )}

  <AiNotice />

  <AutresRubriques sauf={section} />
</BaseLayout>
